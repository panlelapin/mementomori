<?xml version="1.0" encoding="utf-8"?>
<!-- Static outlined Noto Mono preview; no launcher font substitution or full-width thin space. -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_preview_background"
    android:contentDescription="@string/widget_preview_text"
    android:padding="8dp"
    android:scaleType="fitCenter"
    android:src="@drawable/widget_preview_text"
    tools:ignore="Overdraw" />
